  /// Calculates the complete order summary including subtotal, discounts, promotions, and taxes
  /// 
  /// [ref] - Riverpod reference for accessing providers
  /// [cartItems] - List of items in the cart
  /// [discountType] - Type of discount (fixed value or percentage)
  /// [discountValue] - Value of the discount
  /// [discountAmount] - Discount amount from the provider
  /// [payments] - List of payment methods and amounts
  /// [promotionsServices] - Service for applying promotions
  /// [decimalsSetting] - Decimal precision setting
  /// [context] - BuildContext for showing validation messages (optional)
  /// 
  /// Returns an [OrderSummary] object with all calculated values
  /// 
  /// Throws [ArgumentError] if cart is empty or total amount is negative
  static Future<OrderSummary> calculate({
    required Ref ref,
    required List<CartItem> cartItems,
    required DiscountType? discountType,
    required double discountValue,
    required double discountAmount,
    required int? customerId,
    required List<PaymentItem> payments,
    required PromotionsServices promotionsServices,
    required DecimalsNumbers decimalsSetting,
    required BuildContext context,
  }) async {
    final manualPromos = ref.read(appliedPromotionsProvider);

    // 1. Calculate subtotal
    double subtotal = cartItems.fold(0, (sum, item) {
      final priceWithoutTax = (item.inclusive) ? item.price : item.price / (1.15);
      return sum + priceWithoutTax * item.quantity;
    });

    // 2. Use discountAmount from provider
    // double discountAmount = 0.0;
    // if (discountType != null) {
    //   discountAmount = discountType == DiscountType.fixedValue
    //       ? discountValue
    //       : (subtotal * (discountValue / 100));
    // }
    // discountAmount = discountAmount.clamp(0, subtotal);

    // 3. Build a SalesInvoice for promotion calculation
    final salesOrderModel = SalesOrderModel(
      id: null,
      createdAt: '',
      updatedAt: '',
      deletedAt: '',
      cashierName: '',
      customerId: customerId,
      invoiceId: null,
      haveRefund: 0,
      cashierShiftId: 0,
      workDate: '',
      subTotalBeforeDiscount: subtotal.toStringAsFixed(2),
      totalAmountBeforeDiscount: '',
      taxBeforeDiscount: '',
      subTotal: subtotal.toStringAsFixed(2),
      tax: '',
      totalAmount: '',
      note: '',
      isRefund: 0,
      userId: '',
      tenantId: '',
      discountType: discountType == DiscountType.fixedValue
          ? 1
          : discountType == DiscountType.percentage
              ? 2
              : 0,
      discountValue: discountValue,
      discount: discountAmount,
      discountAmount: discountAmount ,
      uuid: '',
      orderNumber: '',
      receiptNumber: '',
      isBackOfficeSync: 0,
      isZactaSync: 0,
      customerPhone: '',
      paymentMethod: 0,
      saleTypeId: 0,
    );
    final salesOrderItems = cartItems
        .map((item) => SalesItemsModel(
              id: null,
              createdAt: '',
              updatedAt: '',
              productId: item.productId,
              categoryId: item.categoryId,
              productNameEn: item.nameEn,
              productNameAr: item.nameAr,
              unitOfMeasureId: item.unitId.toString(),
              quantity: item.quantity.toString(),
              price: item.price.toString(),
              total: '',
              note: '',
              tax: '',
              isRefund: 0,
              userId: '',
              tenantId: '',
              uniqueId: '',
              invoiceId: '',
              isExclusive: item.inclusive,
              discount: 0.0,
              loyaltyDiscount: 0.0,
              promotionValue: 0.0,
              vatBeforeDiscount: 0.0,
              additionalAllowns: 0.0,
              priceIncludeVAT: 0.0,
            ))
        .toList();
    final salesInvoice = SalesInvoice(
      salesOrderModel: salesOrderModel,
      salesOrderItems: salesOrderItems,
      salesOrderPayMethods: [],
    );

    // 4. Apply promotions (automatic + manual)
    final invoiceWithPromotions = await PromotionsServices.applyAllPromotionsToInvoice( ref,salesInvoice,manualPromos);
    double orderPromotionAmount = invoiceWithPromotions.salesOrderModel.promotionAmount ?? 0;
    double itemPromotionsTotal = invoiceWithPromotions.salesOrderItems.fold<double>(
      0, (sum, item) => sum + (item.promotionAmount ?? 0));
    double promotionAmount = orderPromotionAmount + itemPromotionsTotal;

    // 5. Calculate tax and total after promotions
    double taxableAmount = subtotal - promotionAmount;
    double taxAmount = taxableAmount * 0.15;
    double totalAmount = taxableAmount + taxAmount;
    
    // 6. Check if total amount is negative and handle by removing promotions/discounts
    List<String> validationMessages = [];
    if (totalAmount < 0) {
      validationMessages.add(_createValidationMessage('negative_total'));
      // Do NOT remove or zero out promotions here!
      // Let each promotion handler manage its own criteria.
    }
    
    // Calculate payment totals
    double totalPaid = payments.fold(0, (sum, item) => sum + item.amount);
    double remaining = (totalAmount - totalPaid).clamp(0, double.infinity);
    double change = (totalPaid > totalAmount) ? (totalPaid - totalAmount) : 0.0;

    // 8. Rounding with validation
    double roundNum(num value) {
      if (value.isNaN || value.isInfinite) {
        return 0.0;
      }
      if (decimalsSetting == DecimalsNumbers.two) {
        return (value * 100).roundToDouble() / 100;
      } else {
        return (value * 100000).roundToDouble() / 100000;
      }
    }

    // 9. Validate final amounts
    if (totalAmount < 0) {
      throw ArgumentError('Total amount cannot be negative');
    }
   
     dPrint("#####orderSummary.validationMessages${validationMessages}");

    // Show validation messages to user if context is provided
    if (validationMessages.isNotEmpty) {
      dPrint("Showing validation messages: $validationMessages");
      await _showValidationMessages(validationMessages, context);
    }
    
    return OrderSummary(
      subtotal: roundNum(subtotal),
      discountAmount: roundNum(discountAmount),
      promotionAmount: roundNum(promotionAmount),
      taxAmount: roundNum(taxAmount),
      totalAmount: roundNum(totalAmount),
      totalPaid: roundNum(totalPaid),
      remaining: roundNum(remaining),
      change: roundNum(change),
      taxBeforeDiscount: roundNum(taxAmount),
      totalAmountBeforeDiscount: roundNum(subtotal + taxAmount),
      subTotalBeforeDiscount: roundNum(subtotal),
      orderPromotionValue: roundNum(orderPromotionAmount),
      orderPromotionType: invoiceWithPromotions.salesOrderModel.promotionType,
      orderPromotionAmount: roundNum(orderPromotionAmount),
      orderPromotionCode: invoiceWithPromotions.salesOrderModel.promotionCode,
      itemPromotions: Map.fromEntries(
        invoiceWithPromotions.salesOrderItems
            .where((item) => 
                item.promotionAmount != null && 
                item.promotionAmount! > 0 )
            .map((item) => MapEntry(
                  int.parse(item.productId),
                  ItemPromotionData(
                    promotionValue: roundNum(item.promotionValue ?? 0),
                    promotionType: item.promotionType,
                    promotionAmount: roundNum(item.promotionAmount ?? 0),
                    promotionCode: item.promotionCode,
                    promotionId: item.promotionId,
                  ),
                )),
      ),
      promotionsRemoved: false,
      validationMessages: validationMessages,
      discountType:  discountType == DiscountType.percentage? 1:0,
      discount: discountValue,
      customerId: customerId,
    );
  }
} 



